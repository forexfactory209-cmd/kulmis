// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FREELANCER
  CLIENT
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProgressStepStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DisputeStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
}

enum ContractStatus {
  PENDING_ADMIN_REVIEW
  PENDING_FREELANCER_APPROVAL
  ACTIVE
  CANCELLED
}

enum PayrollStatus {
  UNPAID
  PAID
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  role              UserRole  @default(CLIENT)
  firstName         String?
  lastName          String?
  avatarUrl         String?
  isVerified        Boolean   @default(false)
  twoFactorEnabled  Boolean   @default(false)
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  projects          Project[]          @relation("ClientProjects")
  transactions      Transaction[]
  sentMessages      Message[]          @relation("SentMessages")
  notifications     Notification[]
  tickets           SupportTicket[]
  disputesInitiated Dispute[]          @relation("Initiator")
  reviewsGiven      Review[]           @relation("Reviewer")
  reviewsReceived   Review[]           @relation("Reviewee")
  conversations     UserConversation[]
  favorites         FavoriteFreelancer[] @relation("ClientFavorites")
  favoritedBy       FavoriteFreelancer[] @relation("FreelancerFavorited")
  clientInvitations ProjectInvitation[]  @relation("ClientInvitations")
  freelancerInvitations ProjectInvitation[] @relation("FreelancerInvitations")

  retainerContractsAsClient     RetainerContract[] @relation("ClientRetainers")
  retainerContractsAsFreelancer RetainerContract[] @relation("FreelancerRetainers")

  businessProfile BusinessProfile?
  workerContracts Contract[]       @relation("WorkerContracts")
  attendances     Attendance[]
  assignedTasks   Task[]           @relation("AssignedTasks")

  projectFiles         ProjectFile[]
  projectDiscussions   ProjectDiscussion[]
  projectStepRevisions ProjectStepRevision[]
  reports              Report[]

  @@index([role, deletedAt])
}

model FreelancerProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  title        String?
  bio          String?       @db.Text
  hourlyRate   Decimal?      @db.Decimal(10, 2)
  availability String?
  portfolioUrl String?
  skills       Skill[]
  portfolios   Portfolio[]
  certificates Certificate[]
  proposals    Proposal[]
  progressTemplates ProgressTemplate[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ClientProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String?
  website     String?
  bio         String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Report {
  id        String   @id @default(uuid())
  title     String
  type      String   // Finance, HR, Operations
  size      String   // e.g., '1.2 MB'
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          String              @id @default(uuid())
  name        String              @unique
  freelancers FreelancerProfile[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Portfolio {
  id           String            @id @default(uuid())
  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  title        String
  description  String?           @db.Text
  imageUrl     String?
  link         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Certificate {
  id           String            @id @default(uuid())
  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  name         String
  issuingOrg   String
  issueDate    DateTime?
  imageUrl     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Project {
  id          String         @id @default(uuid())
  clientId    String
  client      User           @relation("ClientProjects", fields: [clientId], references: [id])
  title       String
  description String         @db.Text
  budget      Decimal        @db.Decimal(10, 2)
  status      ProjectStatus  @default(OPEN)
  category    String?
  deadline    DateTime?
  proposals   Proposal[]
  escrow      EscrowPayment?
  reviews     Review[]
  disputes    Dispute[]
  progressSteps ProjectProgressStep[]
  invitations ProjectInvitation[]
  files       ProjectFile[]
  discussions ProjectDiscussion[]
  activities  ProjectActivity[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, deletedAt])
}

model Proposal {
  id           String            @id @default(uuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  freelancerId String
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
  coverLetter  String            @db.Text
  bidAmount    Decimal           @db.Decimal(10, 2)
  duration     String?
  status       ProposalStatus    @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId])
  @@index([freelancerId])
}

model ProjectInvitation {
  id             String         @id @default(uuid())
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  clientId       String
  client         User           @relation("ClientInvitations", fields: [clientId], references: [id])
  freelancerId   String
  freelancer     User           @relation("FreelancerInvitations", fields: [freelancerId], references: [id])
  status         ProposalStatus @default(PENDING)
  jobType        String?        // "PROJECT_BASED" | "MONTHLY_WORKER"
  paymentAmount  Float?
  message        String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
  @@index([freelancerId])
}


model ProgressTemplate {
  id           String                 @id @default(uuid())
  freelancerId String
  freelancer   FreelancerProfile      @relation(fields: [freelancerId], references: [id])
  name         String
  category     String?
  steps        ProgressTemplateStep[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([freelancerId])
}

model ProgressTemplateStep {
  id         String           @id @default(uuid())
  templateId String
  template   ProgressTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([templateId])
}

model ProjectProgressStep {
  id         String             @id @default(uuid())
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int
  status        ProgressStepStatus @default(PENDING)
  submissionMsg String?            @db.Text
  submissionUrl String?
  revisions     ProjectStepRevision[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([projectId])
}

model EscrowPayment {
  id        String       @id @default(uuid())
  projectId String       @unique
  project   Project      @relation(fields: [projectId], references: [id])
  amount    Decimal      @db.Decimal(10, 2)
  status    EscrowStatus @default(HELD)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  amount    Decimal           @db.Decimal(10, 2)
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  reference String?           @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
}

model Review {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int      @default(5)
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([revieweeId])
}

model Conversation {
  id        String             @id @default(uuid())
  messages  Message[]
  users     UserConversation[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model UserConversation {
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  lastReadAt     DateTime?

  @@id([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String       @db.Text
  type           String       @default("TEXT")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SupportTicket {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  subject     String
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  priority    String       @default("MEDIUM")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Dispute {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  initiatorId String
  initiator   User          @relation("Initiator", fields: [initiatorId], references: [id])
  reason      String        @db.Text
  status      DisputeStatus @default(PENDING)
  resolution  String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AdminRole {
  id          String @id @default(uuid())
  name        String @unique
  permissions Json
}

model RetainerContract {
  id            String         @id @default(uuid())
  clientId      String
  client        User           @relation("ClientRetainers", fields: [clientId], references: [id])
  freelancerId  String
  freelancer    User           @relation("FreelancerRetainers", fields: [freelancerId], references: [id])
  status        ContractStatus @default(PENDING_ADMIN_REVIEW)
  monthlyRate   Decimal        @db.Decimal(10, 2)
  workerRate    Decimal        @db.Decimal(10, 2)
  platformFee   Decimal        @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  payrollCycles PayrollCycle[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clientId])
  @@index([freelancerId])
}

model PayrollCycle {
  id           String           @id @default(uuid())
  contractId   String
  contract     RetainerContract @relation(fields: [contractId], references: [id])
  billingMonth DateTime
  status       PayrollStatus    @default(UNPAID)
  amount       Decimal          @db.Decimal(10, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([contractId])
}

model BusinessProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id])
  companyName String
  industry    String?
  balance     Float      @default(0)
  contracts   Contract[]
  tasks       Task[]
}

model Contract {
  id             String          @id @default(uuid())
  businessId     String
  workerId       String
  business       BusinessProfile @relation(fields: [businessId], references: [id])
  worker         User            @relation("WorkerContracts", fields: [workerId], references: [id])
  employmentType String
  monthlySalary  Float
  platformFee    Float
  status         ContractStatus
  schedule       String
  startDate      DateTime
  createdAt      DateTime        @default(now())
  payrolls       Payroll[]

  @@index([businessId])
  @@index([workerId])
}

model Payroll {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  baseSalary  Float
  deductions  Float         @default(0)
  bonuses     Float         @default(0)
  totalAmount Float
  status      PayrollStatus
  invoiceUrl  String?
}

model Attendance {
  id          String    @id @default(uuid())
  workerId    String
  worker      User      @relation(fields: [workerId], references: [id])
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      String
  leaveReason String?
}

model FavoriteFreelancer {
  id           String   @id @default(uuid())
  clientId     String
  client       User     @relation("ClientFavorites", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User     @relation("FreelancerFavorited", fields: [freelancerId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([clientId, freelancerId])
  @@index([clientId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  businessId  String
  business    BusinessProfile @relation(fields: [businessId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  category    String?
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([businessId])
  @@index([assigneeId])
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  name       String
  fileUrl    String
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model ProjectDiscussion {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model ProjectStepRevision {
  id         String             @id @default(uuid())
  stepId     String
  step       ProjectProgressStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation(fields: [authorId], references: [id])
  content    String             @db.Text
  createdAt  DateTime           @default(now())

  @@index([stepId])
}

model ProjectActivity {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content     String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([projectId])
}
